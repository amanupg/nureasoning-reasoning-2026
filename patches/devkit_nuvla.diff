diff --git a/nureasoning/nuvla/models/data_loader.py b/nureasoning/nuvla/models/data_loader.py
index f18a9d1..285d514 100644
--- a/nureasoning/nuvla/models/data_loader.py
+++ b/nureasoning/nuvla/models/data_loader.py
@@ -223,14 +223,40 @@ class NuReasoningVLADataset(Dataset):
             if not ego_state_relpath:
                 continue
 
+            # [nuReasoning challenge entry, amanupg] We ingested camera images for the
+            # key frames only. Keep a reasoning frame if its images (current + history)
+            # are on disk, else try the adjacent frame (+-1, 0.1 s): some clips annotate
+            # frames 31, 41, ..., 101 while images exist at 90/100. The sample then uses
+            # the image frame's ego state and timestamp with this reasoning text.
+            if os.environ.get("NUVLA_REQUIRE_IMAGES"):
+                def _has_images(fi):
+                    return all(
+                        0 <= i < len(frames)
+                        and all(os.path.isfile(os.path.join(clip_dir, p))
+                                for p in (frames[i].get("sensors", {}).get("cameras", {}) or {}).values())
+                        for i in [fi - k * hist_stride for k in range(self.config.num_history_steps + 1)]
+                    )
+                alt = next((fi for fi in (frame_idx, frame_idx - 1, frame_idx + 1) if _has_images(fi)), None)
+                if alt is None:
+                    continue
+                if alt != frame_idx:
+                    frame = frames[alt]
+                    frame_idx = alt
+                    ego_state_relpath = frame.get("ego_state", "")
+                    if not ego_state_relpath or frame_idx < min_history_frames:
+                        continue
+
             self.samples.append({
                 "clip_dir": clip_dir,
                 "clip_name": clip_name,
                 "frame_index": frame_idx,
                 "timestamp_us": frame.get("timestamp_us", 0),
                 "reasoning_file": reasoning_abs,
-                "metadata": metadata,
-                "frames": frames,
+                # [amanupg] NUVLA_LAZY_META: don't hold every clip's full metadata in every
+                # sample; forked loader workers copy-on-write it and host RAM runs out
+                # ("pin memory thread exited"). __getitem__ re-reads it from disk.
+                "metadata": None if os.environ.get("NUVLA_LAZY_META") else metadata,
+                "frames": None if os.environ.get("NUVLA_LAZY_META") else frames,
             })
 
     def _index_vqa(self) -> None:
@@ -304,8 +330,13 @@ class NuReasoningVLADataset(Dataset):
         clip_dir = info["clip_dir"]
         frame_idx = info["frame_index"]
         frames = info["frames"]
+        meta = info.get("metadata")
+        if frames is None:                       # NUVLA_LAZY_META
+            with open(os.path.join(clip_dir, "metadata.json"), "r") as f:
+                meta = json.load(f)
+            frames = meta.get("frames", [])
         clip_frame_rate_hz = infer_clip_frame_rate_hz(
-            info.get("metadata", {}),
+            meta or {},
             frames,
             self.config.frame_rate_hz,
         )
